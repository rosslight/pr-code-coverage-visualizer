    "glob": "^11.0.0",
    "minimatch": "^10.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@octokit/webhooks-types": "7.6.1",
    "@tsconfig/node20": "20.1.8",
    "@tsconfig/strictest": "2.0.8",
    "@types/minimatch": "^6.0.0",
    "@types/node": "20.19.27",
    "@vercel/ncc": "0.38.4",
    "@vitest/coverage-v8": "4.0.16",
    "pnpm": "10.26.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
